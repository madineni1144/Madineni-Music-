# Copy to config/.env or set ENV_FILE to your own file.
# Existing systemd DB_* values take precedence. Never commit real passwords.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=music_app
DB_USER=postgres
DB_PASSWORD=
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://madinenimusic.madineni.xyz
CORS_ORIGINS=https://madinenimusic.madineni.xyz
TRUST_PROXY=loopback
API_RATE_LIMIT=600
LYRICS_RATE_LIMIT=60

# Existing Ubuntu directories are selected automatically when present.
# Local development otherwise uses paths relative to the repository.
# FRONTEND_DIR=/opt/musicapp/app/frontend
# MUSIC_DIR=/opt/musicapp/music/Songs
# COVERS_DIR=/opt/musicapp/covers
# PYTHON_BIN=python3
# MUSICAPP_ENV_FILE=/etc/musicapp.env
# STAGING_DIR=/opt/musicapp/staging/incoming
# REPORT_DIR=/opt/musicapp/reports

# Keep false until the native iOS app also follows pagination.
# The updated web players already request all pages.
SONGS_PAGINATION_ENABLED=false

# Optional caching for audio files. Leave 0 if files change at the same URL.
MUSIC_CACHE_MAX_AGE=0
