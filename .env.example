# Copy to /opt/musicapp/app/config/.env (or set ENV_FILE) and fill in real values.
# Never commit the real file.

# --- PostgreSQL (database: music_app) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=music_app
DB_USER=
DB_PASSWORD=

# --- API server (defaults shown match the current Ubuntu deployment) ---
PORT=3000
FRONTEND_DIR=/opt/musicapp/app/frontend
MUSIC_DIR=/opt/musicapp/music/Songs
COVERS_DIR=/opt/musicapp/covers

# Shared secret for write endpoints (playlist create/delete/edit, manual lyrics).
# When set, clients must send "Authorization: Bearer <value>".
# When empty, writes stay open (legacy behaviour) - set this before exposing the API publicly.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS. Empty keeps the current open policy.
CORS_ORIGINS=

# Set to "true" only in development to include internal error text in API responses.
EXPOSE_ERROR_DETAILS=false
