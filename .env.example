# Copy to /opt/musicapp/app/config/.env (or point ENV_FILE at it) and fill in real values.
# Never commit the real file.

# --- PostgreSQL (database: music_app) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=music_app
DB_USER=
DB_PASSWORD=

# --- API server (defaults shown match the current Ubuntu deployment) ---
PORT=3000
FRONTEND_DIR=/opt/musicapp/app/frontend
MUSIC_DIR=/opt/musicapp/music/Songs
COVERS_DIR=/opt/musicapp/covers
NODE_ENV=production

# --- Write authentication (REQUIRED for playlist edits and the lyrics editor) ---
# Playlist create/add/remove/delete and manual lyrics saves require
#   Authorization: Bearer <MUSICAPP_WRITE_TOKEN>
# Fail-closed: if this is empty or shorter than 32 characters, every write route
# answers 503 and nothing is writable. Reading and playback are unaffected.
# Generate one with:  openssl rand -hex 32
# Keep it out of git, the frontend, and URLs. Users type it manually in the app.
MUSICAPP_WRITE_TOKEN=

# Writes must arrive over HTTPS (403 otherwise). Set to "false" only on a trusted LAN/dev box
# (this also removes the protection for tunnel traffic).
MUSICAPP_REQUIRE_HTTPS=true
# How HTTPS is proven behind a proxy. "none" (default): forwarded headers are ignored, so writes
# need TLS in this process or REQUIRE_HTTPS=false. "cloudflare": trust a loopback cloudflared that
# supplies BOTH X-Forwarded-Proto (rightmost value) and CF-Visitor = https. See docs/DEPLOYMENT.md.
MUSICAPP_PROXY_MODE=none
# Peers allowed to vouch for HTTPS: "loopback" and/or exact IPs, comma-separated.
MUSICAPP_TRUSTED_PROXIES=loopback

# --- Brute-force and cost limits (defaults shown) ---
# Failed-auth lockout per client, plus a global ceiling (valid tokens are never blocked by the global one)
MUSICAPP_AUTH_FAIL_MAX=10
MUSICAPP_AUTH_FAIL_WINDOW_SEC=900
MUSICAPP_AUTH_FAIL_GLOBAL_MAX=200
# Explicit lyrics refresh (?refresh=1): needs the write token and is throttled
MUSICAPP_REFRESH_SONG_COOLDOWN_SEC=300
MUSICAPP_REFRESH_PER_CLIENT_HOUR=20
MUSICAPP_REFRESH_OVERALL_HOUR=60

# --- CORS ---
# Comma-separated browser origins allowed cross-origin, e.g. https://music.example.com
# Empty = same-origin only. CORS is not a substitute for authentication.
CORS_ORIGINS=

# --- Pagination for GET /api/songs ---
MUSICAPP_DEFAULT_PAGE_SIZE=100
MUSICAPP_MAX_PAGE_SIZE=500

# Development only: include internal error text in API responses (ignored when NODE_ENV=production).
EXPOSE_ERROR_DETAILS=false

# --- Audio pipeline path overrides (defaults shown; pipeline stays paused) ---
# MUSICAPP_MUSIC_ROOT=/opt/musicapp/music/Songs
# MUSICAPP_STAGING_DIR=/opt/musicapp/staging/incoming
# MUSICAPP_REPORT_DIR=/opt/musicapp/reports
# MUSICAPP_DB_ENV_FILE=/etc/musicapp.env
# MUSICAPP_EMAIL_ENV=/etc/musicapp-email.env
# GOOGLE_DRIVE_TOKEN_FILE=/home/rk/google_drive_token.json
# GOOGLE_OAUTH_CLIENT_FILE=/home/rk/google_oauth.json
